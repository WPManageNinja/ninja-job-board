{
    "name": "wpmanageninja/ninja-job-board",
    "description": "Ninja Job Board WordPress plugin (development tooling only; the plugin has no Composer runtime dependencies)",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload-dev": {
        "psr-4": {
            "NinjaJobBoard\\Tests\\": "tests/php/"
        }
    },
    "scripts": {
        "test:integration": "NJB_INTEGRATION=1 phpunit -c phpunit.integration.xml"
    },
    "config": {
        "sort-packages": true
    }
}
