{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "ninja-job-board/job-list",
    "title": "Job List",
    "category": "widgets",
    "icon": "portfolio",
    "description": "A list of your open jobs, with an optional category filter.",
    "keywords": ["jobs", "careers", "openings", "vacancies"],
    "textdomain": "ninja-job-board",
    "attributes": {
        "title": { "type": "string", "default": "Open positions" },
        "categories": { "type": "array", "items": { "type": "string" }, "default": [] },
        "showFilter": { "type": "boolean", "default": true },
        "currentOnly": { "type": "boolean", "default": true },
        "postsPerPage": { "type": "number", "default": 20 },
        "order": { "type": "string", "enum": ["DESC", "ASC"], "default": "DESC" }
    },
    "supports": {
        "html": false,
        "align": ["wide", "full"],
        "spacing": { "margin": true, "padding": true }
    },
    "editorScript": "wpjobboard-blocks",
    "editorStyle": "wpjobboard-blocks-editor",
    "style": "wpjobboard_list"
}
