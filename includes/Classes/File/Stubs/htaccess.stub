# BEGIN Ninja Job Board
# Application files (CVs) are personal data. The plugin serves them through
# wp-admin/admin-post.php?action=wpjb_download_file after a permission check,
# so nobody needs to open this folder directly.
Options -Indexes

<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>

# Never run scripts from this folder
<Files *>
  SetHandler none
  SetHandler default-handler
  Options -ExecCGI
  RemoveHandler .cgi .php .php3 .php4 .php5 .phtml .pl .py .pyc .pyo
</Files>
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
# END Ninja Job Board
